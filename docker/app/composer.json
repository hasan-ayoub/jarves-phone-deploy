{
    "name": "local/jarves-app",
    "license": "proprietary",
    "type": "project",
    "repositories": [
        { "type": "path", "url": "/var/www/jarves", "options": { "symlink": true } }
    ],
    "require": {
        "php": ">=5.6",
        "jarves/jarves": "@dev",
        "jarves/demotheme-bundle": "dev-master",
        "symfony/symfony": "3.1.5",
        "propel/propel": "2.0.0-alpha6",
        "propel/propel-bundle": "3.0.0-alpha1",
        "friendsofsymfony/rest-bundle": "2.1.0",
        "nelmio/api-doc-bundle": "2.13.0",
        "composer/composer": "1.0.0",
        "twig/twig": "1.26.1"
    },
    "autoload": { "psr-4": { "": "src/" } },
    "minimum-stability": "alpha",
    "prefer-stable": false,
    "config": { "platform": { "php": "7.0.33" } }
}
